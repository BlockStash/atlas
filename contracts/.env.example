# Dedicated Sepolia deployer. Do not reuse Arkiv or World ID signing keys.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
TREASURY_ADDRESS=
MINTER_ADDRESS=
PAUSER_ADDRESS=
MARKET_ADMIN_ADDRESS=
PRICE_UPDATER_ADDRESS=
# Optional existing six-decimal token; leave empty to deploy demo AtlasUSDT.
SETTLEMENT_TOKEN_ADDRESS=
# Optional reuse of an existing AtlasVault; its asset must match SETTLEMENT_TOKEN_ADDRESS.
EXISTING_VAULT_ADDRESS=
# Set true only when an explicitly supplied settlement asset is Atlas demo USDT.
SETTLEMENT_TOKEN_IS_DEMO=false
# Optional broad operations admin on all five country markets (cannot upgrade/grant roles).
COUNTRY_ADMIN_ADDRESS=
