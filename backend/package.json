{
  "name": "atlas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "node --import tsx --test test/*.test.ts",
    "arkiv:check": "tsx scripts/arkiv-check.ts",
    "prices:update": "tsx scripts/update-country-prices.ts",
    "prices:update:legacy": "tsx scripts/update-prices.ts",
    "prices:watch": "tsx scripts/update-country-prices.ts --watch"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@ensdomains/ensjs": "^5.2.12",
    "@simplewebauthn/server": "^13.3.3",
    "@worldcoin/idkit-core": "^4.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "viem": "^2.57.16",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
