PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Explicitly enable investor demo authentication and proof simulation locally.
DEMO_WALLET=false
DEMO_WORLD_ID=false
# Never expose these demo features in a production environment.
NODE_ENV=development
DATA_FILE=./data/profiles.json

# World ID 4.0: values from https://developer.world.org
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_ACTION=verify-human
# Server-only RP signing key. Never add NEXT_PUBLIC_ to this variable.
WORLD_ID_SIGNING_KEY=
# production for World App; staging only for the official simulator.
WORLD_ID_ENVIRONMENT=production

# Passkey (WebAuthn) human verification. Defaults to FRONTEND_ORIGIN's hostname;
# local 127.0.0.1 maps to "localhost" (IP addresses cannot be WebAuthn RP IDs).
PASSKEY_RP_ID=

PROFILE_STORE=arkiv
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Free RPC access key from https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
ARKIV_CHAIN_ID=7794095
ARKIV_NAMESPACE=atlas-poc
ARKIV_PRIVATE_KEY=
ARKIV_ENCRYPTION_KEY=
# Optional: maximum fee in wei for one Arkiv write (default 20000000000000000 = 0.02 tGLM)
ARKIV_MAX_TX_FEE_WEI=
IDENTITY_CLAIMS_FILE=./data/world-id-claims.sqlite
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

ARKIV_SIGNER_ADDRESS=0xB9B85F4b79671A95365CF60F1767F63D4B8F1040

# Protocol contract reads (public addresses from the Sepolia deployment manifest).
PROTOCOL_DEPLOYMENT_FILE=../contracts/deployments/sepolia-v2.json
PROTOCOL_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRICE_HISTORY_FILE=./data/prices.sqlite
# demo, http, twelvedata-kraken, or explicit historical-development test quotes.
PRICE_SOURCE=demo
PRICE_PROVIDER_URL=
PRICE_PROVIDER_TOKEN=
# Server-only API key from https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
# Explicit stock/exchange mapping; includes all 10 US stocks (WS + paced REST).
MARKET_FEED_CONFIG=./config/market-feed.json
MARKET_FEED_CACHE_FILE=./data/market-feed.json
# Dated historical references and cached exchange status.
WEB_REFERENCE_FILE=./config/web-market-reference.json
MARKET_STATUS_FILE=./data/market-status.json
# Local/Sepolia development only: renew the five Atlas market windows.
# Does not override an explicit market pause; quote source is configured separately.
ATLAS_DEVELOPMENT_MARKETS=false
# Used only with PRICE_SOURCE=historical-development outside production on Sepolia/local.
DEVELOPMENT_PRICE_MAX_AGE_SECONDS=86400
DEVELOPMENT_PRICE_BASIS_FILE=./config/development-price-basis.json
MARKET_ADMIN_PRIVATE_KEY=
# Dated FX for historical display and explicit development test quotes.
FX_REFERENCE_FILE=./config/fx-reference.json
# Minimum 60; 300 publishes at most once per market every five minutes.
PRICE_PUBLISH_INTERVAL_SECONDS=300
# Dedicated PRICE_UPDATER_ROLE signer; never reuse Arkiv or World ID keys.
PRICE_UPDATER_PRIVATE_KEY=
# v2: one upgradeable multi-stock contract per market.
# PROTOCOL_DEPLOYMENT_FILE=../contracts/deployments/sepolia-v2.json
# Real provider snapshots must include usdt: { usdPrice: "0.9998", timestamp: ... }.
# Persistent observed account-value history; portfolio balances themselves come from Sepolia.
PORTFOLIO_HISTORY_FILE=./data/portfolio-history.sqlite

# AI Intent Trading Engine. Without ANTHROPIC_API_KEY a deterministic rule parser handles the V1 grammar.
ANTHROPIC_API_KEY=
INTENT_AI_MODEL=claude-sonnet-5-5
# Defaults to true outside production. Demo mode = fixture prices, demo signatures, simulated execution ledger.
INTENT_DEMO_MODE=true
INTENT_WORKER_ENABLED=true
INTENT_WORKER_INTERVAL_MS=5000
INTENT_DB_FILE=./data/intents.sqlite
# Trading never uses a price older than this.
INTENT_MAX_PRICE_AGE_S=900
INTENT_DEMO_START_USDT=25000
# Risk limits (not overridable by the AI or the user).
INTENT_MAX_TRADE_USDT=50000
INTENT_MAX_PORTFOLIO_PERCENT=50
INTENT_MAX_ACTIVE=10
INTENT_MAX_SLIPPAGE_BPS=300
# Optional on-chain mirror in AtlasIntentManager (executor key needs EXECUTOR_ROLE). Server-side secret only.
INTENT_MANAGER_ADDRESS=
INTENT_EXECUTOR_PRIVATE_KEY=

# /api/paper is development-only, wallet-scoped and independent of PRICE_SOURCE.
# No simulator key is required. It optionally reuses ANTHROPIC_API_KEY/INTENT_AI_MODEL above.
# Paper balances and prices never use PRICE_UPDATER_PRIVATE_KEY or a contract publisher.
